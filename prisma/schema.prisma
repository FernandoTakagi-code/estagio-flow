generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Perfil {
  aluno
  professora
  coordenacao

  @@map("perfil")
}

model Instituicao {
  id            String             @id @default(uuid()) @db.Uuid
  nome          String             @db.VarChar(200)
  criadoEm      DateTime           @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm  DateTime           @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  usuarios      Usuario[]
  turmas        Turma[]
  importacoes   ImportacaoAlunos[]
  disciplinas   Disciplina[]
  camposEstagio CampoEstagio[]

  @@map("instituicao")
}

model Usuario {
  id                  String             @id @default(uuid()) @db.Uuid
  instituicaoId       String             @map("instituicao_id") @db.Uuid
  nome                String             @db.VarChar(200)
  email               String             @unique @db.VarChar(254)
  senhaHash           String?            @map("senha_hash") @db.Text
  perfil              Perfil
  coren               String?            @db.VarChar(30)
  ativo               Boolean            @default(true)
  tokenVersao         Int                @default(0) @map("token_versao")
  criadoPorId         String?            @map("criado_por_id") @db.Uuid
  criadoEm            DateTime           @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm        DateTime           @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  instituicao         Instituicao        @relation(fields: [instituicaoId], references: [id], onDelete: Restrict)
  criadoPor           Usuario?           @relation("CriadorUsuario", fields: [criadoPorId], references: [id], onDelete: Restrict)
  usuariosCriados     Usuario[]          @relation("CriadorUsuario")
  convites            ConviteUsuario[]   @relation("DestinatarioConvite")
  convitesCriados     ConviteUsuario[]   @relation("CriadorConvite")
  importacoesCriadas  ImportacaoAlunos[]
  matriculas          MatriculaTurma[]   @relation("AlunoMatricula")
  matriculasCriadas   MatriculaTurma[]   @relation("CriadorMatricula")
  estagiosResponsavel Estagio[]          @relation("ProfessoraEstagio")
  estagiosCriados     Estagio[]          @relation("CriadorEstagio")
  vinculosCriados     VinculoEstagio[]   @relation("CriadorVinculo")
  eventosRegistro    EventoRegistro[]

  @@unique([id, instituicaoId])
  @@index([instituicaoId])
  @@map("usuario")
}

model ImportacaoAlunos {
  id            String      @id @default(uuid()) @db.Uuid
  instituicaoId String      @map("instituicao_id") @db.Uuid
  criadoPorId   String      @map("criado_por_id") @db.Uuid
  dados         Json?
  quantidade    Int
  expiraEm      DateTime    @map("expira_em") @db.Timestamptz(3)
  confirmadaEm  DateTime?   @map("confirmada_em") @db.Timestamptz(3)
  criadoEm      DateTime    @default(now()) @map("criado_em") @db.Timestamptz(3)
  instituicao   Instituicao @relation(fields: [instituicaoId], references: [id], onDelete: Restrict)
  criadoPor     Usuario     @relation(fields: [criadoPorId], references: [id], onDelete: Restrict)

  @@index([instituicaoId, criadoPorId])
  @@index([expiraEm])
  @@map("importacao_alunos")
}

model ConviteUsuario {
  id          String    @id @default(uuid()) @db.Uuid
  usuarioId   String    @map("usuario_id") @db.Uuid
  criadoPorId String    @map("criado_por_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.VarChar(64)
  expiraEm    DateTime  @map("expira_em") @db.Timestamptz(3)
  usadoEm     DateTime? @map("usado_em") @db.Timestamptz(3)
  revogadoEm  DateTime? @map("revogado_em") @db.Timestamptz(3)
  criadoEm    DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  usuario     Usuario   @relation("DestinatarioConvite", fields: [usuarioId], references: [id], onDelete: Restrict)
  criadoPor   Usuario   @relation("CriadorConvite", fields: [criadoPorId], references: [id], onDelete: Restrict)

  @@index([usuarioId])
  @@index([criadoPorId])
  @@map("convite_usuario")
}

model Turma {
  id            String           @id @default(uuid()) @db.Uuid
  instituicaoId String           @map("instituicao_id") @db.Uuid
  codigo        String           @db.VarChar(50)
  criadoEm      DateTime         @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm  DateTime         @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  instituicao   Instituicao      @relation(fields: [instituicaoId], references: [id], onDelete: Restrict)
  matriculas    MatriculaTurma[]
  estagios      Estagio[]

  @@unique([id, instituicaoId])
  @@unique([instituicaoId, codigo])
  @@map("turma")
}

model Disciplina {
  id                String      @id @default(uuid()) @db.Uuid
  instituicaoId     String      @map("instituicao_id") @db.Uuid
  codigo            String      @db.VarChar(50)
  nome              String      @db.VarChar(200)
  cargaHorariaTotal Int         @map("carga_horaria_total")
  criadoEm          DateTime    @default(now()) @map("criado_em") @db.Timestamptz(3)
  instituicao       Instituicao @relation(fields: [instituicaoId], references: [id], onDelete: Restrict)
  estagios          Estagio[]

  @@unique([instituicaoId, codigo])
  @@unique([id, instituicaoId])
  @@map("disciplina")
}

model CampoEstagio {
  id            String      @id @default(uuid()) @db.Uuid
  instituicaoId String      @map("instituicao_id") @db.Uuid
  nome          String      @db.VarChar(200)
  criadoEm      DateTime    @default(now()) @map("criado_em") @db.Timestamptz(3)
  instituicao   Instituicao @relation(fields: [instituicaoId], references: [id], onDelete: Restrict)
  estagios      Estagio[]

  @@unique([instituicaoId, nome])
  @@unique([id, instituicaoId])
  @@map("campo_estagio")
}

model MatriculaTurma {
  id            String           @id @default(uuid()) @db.Uuid
  instituicaoId String           @map("instituicao_id") @db.Uuid
  turmaId       String           @map("turma_id") @db.Uuid
  alunoId       String           @map("aluno_id") @db.Uuid
  criadoPorId   String           @map("criado_por_id") @db.Uuid
  iniciadoEm    DateTime         @default(now()) @map("iniciado_em") @db.Timestamptz(3)
  encerradoEm   DateTime?        @map("encerrado_em") @db.Timestamptz(3)
  turma         Turma            @relation(fields: [turmaId, instituicaoId], references: [id, instituicaoId], onDelete: Restrict)
  aluno         Usuario          @relation("AlunoMatricula", fields: [alunoId, instituicaoId], references: [id, instituicaoId], onDelete: Restrict)
  criadoPor     Usuario          @relation("CriadorMatricula", fields: [criadoPorId, instituicaoId], references: [id, instituicaoId], onDelete: Restrict)
  vinculos      VinculoEstagio[]

  @@unique([id, instituicaoId, turmaId, alunoId])
  @@index([instituicaoId, turmaId])
  @@index([alunoId])
  @@map("matricula_turma")
}

model Estagio {
  id             String           @id @default(uuid()) @db.Uuid
  instituicaoId  String           @map("instituicao_id") @db.Uuid
  codigo         String           @db.VarChar(50)
  turmaId        String           @map("turma_id") @db.Uuid
  disciplinaId   String           @map("disciplina_id") @db.Uuid
  campoEstagioId String           @map("campo_estagio_id") @db.Uuid
  professoraId   String           @map("professora_id") @db.Uuid
  criadoPorId    String           @map("criado_por_id") @db.Uuid
  criadoEm       DateTime         @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm   DateTime         @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  encerradoEm    DateTime?        @map("encerrado_em") @db.Timestamptz(3)
  turma          Turma            @relation(fields: [turmaId, instituicaoId], references: [id, instituicaoId], onDelete: Restrict)
  disciplina     Disciplina       @relation(fields: [disciplinaId, instituicaoId], references: [id, instituicaoId], onDelete: Restrict)
  campoEstagio   CampoEstagio     @relation(fields: [campoEstagioId, instituicaoId], references: [id, instituicaoId], onDelete: Restrict)
  professora     Usuario          @relation("ProfessoraEstagio", fields: [professoraId, instituicaoId], references: [id, instituicaoId], onDelete: Restrict)
  criadoPor      Usuario          @relation("CriadorEstagio", fields: [criadoPorId, instituicaoId], references: [id, instituicaoId], onDelete: Restrict)
  vinculos       VinculoEstagio[]

  @@unique([instituicaoId, codigo])
  @@unique([id, instituicaoId, turmaId, disciplinaId])
  @@index([instituicaoId, professoraId])
  @@index([turmaId])
  @@index([disciplinaId])
  @@index([campoEstagioId])
  @@map("estagio")
}

model VinculoEstagio {
  id            String         @id @default(uuid()) @db.Uuid
  instituicaoId String         @map("instituicao_id") @db.Uuid
  estagioId     String         @map("estagio_id") @db.Uuid
  matriculaId   String         @map("matricula_id") @db.Uuid
  turmaId       String         @map("turma_id") @db.Uuid
  disciplinaId  String         @map("disciplina_id") @db.Uuid
  alunoId       String         @map("aluno_id") @db.Uuid
  criadoPorId   String         @map("criado_por_id") @db.Uuid
  iniciadoEm    DateTime       @default(now()) @map("iniciado_em") @db.Timestamptz(3)
  encerradoEm   DateTime?      @map("encerrado_em") @db.Timestamptz(3)
  estagio       Estagio        @relation(fields: [estagioId, instituicaoId, turmaId, disciplinaId], references: [id, instituicaoId, turmaId, disciplinaId], onDelete: Restrict)
  matricula     MatriculaTurma @relation(fields: [matriculaId, instituicaoId, turmaId, alunoId], references: [id, instituicaoId, turmaId, alunoId], onDelete: Restrict)
  criadoPor     Usuario        @relation("CriadorVinculo", fields: [criadoPorId, instituicaoId], references: [id, instituicaoId], onDelete: Restrict)
  ficha         FichaEstagio?

  @@unique([id, instituicaoId, alunoId])
  @@index([instituicaoId, estagioId])
  @@index([alunoId, disciplinaId])
  @@index([matriculaId])
  @@map("vinculo_estagio")
}

enum StatusRegistro {
  rascunho
  enviado
  devolvido
  cancelado

  @@map("status_registro")
}

model FichaEstagio {
  id            String          @id @default(uuid()) @db.Uuid
  instituicaoId String          @map("instituicao_id") @db.Uuid
  alunoId       String          @map("aluno_id") @db.Uuid
  vinculoId     String          @unique @map("vinculo_id") @db.Uuid
  criadoEm      DateTime        @default(now()) @map("criado_em") @db.Timestamptz(3)
  vinculo       VinculoEstagio  @relation(fields: [vinculoId, instituicaoId, alunoId], references: [id, instituicaoId, alunoId], onDelete: Restrict)
  registros     RegistroEstagio[]

  @@unique([id, instituicaoId, alunoId])
  @@unique([vinculoId, instituicaoId, alunoId])
  @@index([instituicaoId, alunoId])
  @@map("ficha_estagio")
}

model RegistroEstagio {
  id              String          @id @default(uuid()) @db.Uuid
  instituicaoId   String          @map("instituicao_id") @db.Uuid
  alunoId         String          @map("aluno_id") @db.Uuid
  fichaId         String          @map("ficha_id") @db.Uuid
  data            DateTime        @db.Date
  inicioMinuto    Int             @map("inicio_minuto")
  fimMinuto       Int             @map("fim_minuto")
  duracaoMinutos  Int             @map("duracao_minutos")
  atividades      String          @db.VarChar(4000)
  status          StatusRegistro  @default(rascunho)
  versao          Int             @default(1)
  criadoEm        DateTime        @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm    DateTime        @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  ficha           FichaEstagio    @relation(fields: [fichaId, instituicaoId, alunoId], references: [id, instituicaoId, alunoId], onDelete: Restrict)
  eventos         EventoRegistro[]

  @@unique([id, instituicaoId])
  @@index([alunoId, data])
  @@index([fichaId, status])
  @@map("registro_estagio")
}

model EventoRegistro {
  id            String          @id @default(uuid()) @db.Uuid
  instituicaoId String          @map("instituicao_id") @db.Uuid
  registroId    String          @map("registro_id") @db.Uuid
  autorId       String          @map("autor_id") @db.Uuid
  acao          String          @db.VarChar(20)
  versao        Int
  motivo        String?         @db.VarChar(1000)
  snapshot      Json
  criadoEm      DateTime        @default(now()) @map("criado_em") @db.Timestamptz(3)
  registro      RegistroEstagio @relation(fields: [registroId, instituicaoId], references: [id, instituicaoId], onDelete: Restrict)
  autor         Usuario         @relation(fields: [autorId, instituicaoId], references: [id, instituicaoId], onDelete: Restrict)

  @@unique([registroId, versao])
  @@index([instituicaoId, autorId])
  @@map("evento_registro")
}
