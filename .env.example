PORT=3000

# Optional: PostgreSQL connection pool size (1-20; default 5).
DATABASE_POOL_MAX=5

# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="REPLACE_WITH_RANDOM_64_HEX_CHARACTERS"

# Runtime: Supabase transaction pooler (IPv4).
DATABASE_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=verify-full"

# Migrations: direct connection. Use the session pooler on port 5432 if IPv6 is unavailable.
DIRECT_URL="postgresql://postgres:ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=verify-full"
